# From https://developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI in your Spotify app settings.
# Spotify allows plain http only for loopback addresses (127.0.0.1), not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

PORT=8888

# Optional: override the link/QR code guests get (e.g. if you deploy it or use a tunnel)
# PUBLIC_URL=https://jukebox.example.com
